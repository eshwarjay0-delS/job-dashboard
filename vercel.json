{
  "framework": "nextjs",
  "buildCommand": "npm run build -- --webpack",
  "skipMiddlewareRequestBody": true,
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/tailor/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/**": {
      "maxDuration": 60
    },
    "src/app/api/whatsapp/recover/route.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/kompas/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "crons": [
    {
      "path": "/api/agent/watchdog",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/gmail/crawl",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/whatsapp/recover",
      "schedule": "45 11 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "master": true
    }
  }
}
