{
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/**": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "crons": [
    {
      "path": "/api/agent/watchdog",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/gmail/crawl",
      "schedule": "0 12 * * *"
    }
  ]
}
